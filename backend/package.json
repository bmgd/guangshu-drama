    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "hono": "^4.12.9",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
