# Copy to backend/.env for local development. DO NOT commit .env.
# Production: change DB credentials and never reuse these demo defaults.

# PostgreSQL connection (required)
DATABASE_URL=postgres://guangshu:guangshu@127.0.0.1:5432/guangshu_drama

# Server
PORT=5679

# Generated media storage (gitignored under ./data)
STORAGE_PATH=./data/static

# Optional: public base URL for upstream models to fetch local reference media
# PUBLIC_BASE_URL=https://your-domain.example

# Optional concurrency
# IMAGE_CONCURRENCY=3
# VIDEO_CONCURRENCY=2
